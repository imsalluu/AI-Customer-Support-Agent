# SUPPORTIQ AI Backend Environment Configuration
PROJECT_NAME="SUPPORTIQ AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="super-secret-supportiq-enterprise-jwt-signing-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database (PostgreSQL with pgvector or SQLite async for dev/test)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/supportiq
DATABASE_URL="sqlite+aiosqlite:///./supportiq.db"
DATABASE_ECHO=False

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (Optional for external LLM, built-in intelligent fallback provided)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Multi-Channel Webhooks
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="supportiq_verify_token_secure"
